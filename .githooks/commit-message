#!/usr/bin/env bash
#
# commit-message hook: enforces Conventional Commits 1.0.0 and a maximum of
# 75 characters on every line of the commit message.
#
# Setup (once per clone):
#   chmod +x .githooks/commit-message
#   git config core.hooksPath .githooks
#
# Can also be run manually against a file:
#   bash .githooks/commit-message path/to/message.txt

set -u

MSG_FILE="${1:?usage: commit-message <message-file>}"
MAX_LEN=75
TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
SUBJECT_RE='^('"$TYPES"')(\([a-z0-9][a-z0-9._/-]*\))?!?: [^[:space:]](.*[^.[:space:]])?$'

# Drop comment lines (added by git when the message is edited in an editor)
MSG=$(grep -v '^#' "$MSG_FILE" || true)
SUBJECT=${MSG%%$'\n'*}

# Messages generated by git itself are not validated
case "$SUBJECT" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

errors=()

# 1. Subject format: <type>[(scope)][!]: <description>, no trailing period
if ! printf '%s\n' "$SUBJECT" | grep -Eq "$SUBJECT_RE"; then
  errors+=("BAD FORMAT: subject must be <type>(scope)!: <description> with no trailing period")
  errors+=("            allowed types: ${TYPES//|/, }")
fi

# 2. Line 2 must be blank (if the message has a body)
SECOND=$(printf '%s\n' "$MSG" | sed -n '2p')
if [ -n "$SECOND" ]; then
  errors+=("Line 2 must be blank (separate subject and body with an empty line)")
fi

# 3. Every line must be at most MAX_LEN characters
n=0
while IFS= read -r line || [ -n "$line" ]; do
  n=$((n + 1))
  if [ "${#line}" -gt "$MAX_LEN" ]; then
    errors+=("TOO LONG (${#line} chars, max $MAX_LEN) on line $n")
  fi
done <<< "$MSG"

if [ "${#errors[@]}" -gt 0 ]; then
  echo "commit-message: invalid commit message" >&2
  for e in "${errors[@]}"; do
    echo "  - $e" >&2
  done
  exit 1
fi

exit 0
